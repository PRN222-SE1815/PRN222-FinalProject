@page "{classSectionId:int}"
@model Presentation.Areas.Admin.Pages.GradebookManagement.ReviewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Review Gradebook";
    var gradebook = Model.Gradebook;
}

<section class="review-page">
    <div class="review-container">
        <div class="page-header">
            <div class="header-content">
                <h1 class="page-title"><i class="fas fa-eye"></i> Review Gradebook</h1>
                <p class="page-subtitle">Class Section #@Model.ClassSectionId</p>
            </div>
            <a asp-page="Index" class="btn btn-back"><i class="fas fa-arrow-left"></i> Back to List</a>
        </div>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> @Model.SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i> @Model.ErrorMessage
            </div>
        }

        @if (gradebook is not null)
        {
            <div class="gradebook-info">
                <span class="info-label">Gradebook #@gradebook.GradeBookId</span>
                <span class="status-badge status-@gradebook.Status.ToLower().Replace("_", "-")">@gradebook.Status</span>
                <span class="info-label">Version: @gradebook.Version</span>
            </div>

            <div class="action-bar" style="margin-top:0.75rem;">
                <form method="post" asp-page-handler="Export" style="display:inline-flex;">
                    <input type="hidden" name="classSectionId" value="@gradebook.ClassSectionId" />
                    <input type="hidden" name="format" value="csv" />
                    <button type="submit" class="btn btn-view btn-sm">
                        <i class="fas fa-file-csv"></i> Export CSV
                    </button>
                </form>
                <form method="post" asp-page-handler="Export" style="display:inline-flex; margin-left:0.5rem;">
                    <input type="hidden" name="classSectionId" value="@gradebook.ClassSectionId" />
                    <input type="hidden" name="format" value="xlsx" />
                    <button type="submit" class="btn btn-view btn-sm">
                        <i class="fas fa-file-excel"></i> Export XLSX
                    </button>
                </form>
            </div>

            @if (Model.GradeAnalytics is not null)
            {
                <div class="chart-toggle-bar">
                    <button type="button" id="toggleChartsBtn" class="btn btn-view" aria-expanded="false" aria-controls="gradeChartsSection">
                        <i class="fas fa-chart-simple"></i>
                        <span id="toggleChartsText">Hiển thị thống kê biểu đồ</span>
                    </button>
                </div>

                <section id="gradeChartsSection" class="grade-charts is-hidden">
                    <div class="chart-row">
                        <div class="chart-card">
                            <h3 class="chart-title">Phân bố điểm tổng kết</h3>
                            <div class="chart-canvas-wrap">
                                <canvas id="scoreDistributionChart"></canvas>
                            </div>
                        </div>

                        <div class="chart-card">
                            <h3 class="chart-title">Điểm trung bình theo từng bài kiểm tra</h3>
                            <div class="chart-canvas-wrap">
                                <canvas id="gradeItemsPerformanceChart"></canvas>
                            </div>
                        </div>

                        <div class="chart-card">
                            <h3 class="chart-title">Tỉ lệ xếp loại học lực</h3>
                            <div class="chart-canvas-wrap">
                                <canvas id="rankingRatioChart"></canvas>
                            </div>
                        </div>
                    </div>

                    <div class="ranking-row">
                        <div class="chart-card ranking-card">
                            <h3 class="chart-title">Top 3 sinh viên điểm trung bình cao nhất</h3>
                            <div class="mini-table-wrap">
                                <table class="mini-ranking-table">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Student</th>
                                            <th>Điểm TB</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < Model.GradeAnalytics.TopStudents.Count; i++)
                                        {
                                            var student = Model.GradeAnalytics.TopStudents[i];
                                            <tr>
                                                <td>@(i + 1)</td>
                                                <td>
                                                    <div class="mini-student-name">@student.StudentName</div>
                                                    <div class="mini-student-code">@student.StudentCode</div>
                                                </td>
                                                <td>@student.AverageScore.ToString("0.##")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="chart-card ranking-card">
                            <h3 class="chart-title">Top 3 sinh viên điểm trung bình thấp nhất</h3>
                            <div class="mini-table-wrap">
                                <table class="mini-ranking-table">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Student</th>
                                            <th>Điểm TB</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < Model.GradeAnalytics.BottomStudents.Count; i++)
                                        {
                                            var student = Model.GradeAnalytics.BottomStudents[i];
                                            <tr>
                                                <td>@(i + 1)</td>
                                                <td>
                                                    <div class="mini-student-name">@student.StudentName</div>
                                                    <div class="mini-student-code">@student.StudentCode</div>
                                                </td>
                                                <td>@student.AverageScore.ToString("0.##")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>
            }

            @if (gradebook.GradeItems.Count == 0)
            {
                <div class="empty-state">
                    <i class="fas fa-clipboard"></i>
                    <p>No grade items in this gradebook.</p>
                </div>
            }
            else if (Model.EnrollmentRows.Count == 0)
            {
                <div class="empty-state">
                    <i class="fas fa-user-slash"></i>
                    <p>No grade entries recorded.</p>
                </div>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="grade-table">
                        <thead>
                            <tr>
                                <th class="sticky-col">Enrollment</th>
                                @foreach (var item in gradebook.GradeItems)
                                {
                                    <th>
                                        <div class="item-header">
                                            <span class="item-name">@item.ItemName</span>
                                            <span class="item-meta">Max: @item.MaxScore</span>
                                            @if (item.Weight.HasValue)
                                            {
                                                <span class="item-meta">W: @(item.Weight.Value * 100)%</span>
                                            }
                                        </div>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.EnrollmentRows)
                            {
                                <tr id="enrollment-@row.EnrollmentId" class="@(Model.HighlightEnrollmentId == row.EnrollmentId ? "row-focus" : "")">
                                    <td class="sticky-col">
                                        <span class="enrollment-id">#@row.EnrollmentId</span>
                                    </td>
                                    @foreach (var item in gradebook.GradeItems)
                                    {
                                        row.Scores.TryGetValue(item.GradeItemId, out var cellScore);
                                        <td class="score-cell">
                                            @if (cellScore.HasValue)
                                            {
                                                <span class="score-value">@cellScore.Value.ToString("0.##")</span>
                                            }
                                            else
                                            {
                                                <span class="score-empty">—</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (Model.IsPendingApproval)
            {
                <div class="decision-section">
                    <h2 class="decision-title"><i class="fas fa-gavel"></i> Decision</h2>

                    <div class="decision-cards">
                        <!-- Approve -->
                        <form method="post" asp-page-handler="Approve" class="decision-card approve-card">
                            <input type="hidden" name="ClassSectionId" value="@gradebook.ClassSectionId" />
                            <h3><i class="fas fa-check-circle"></i> Approve</h3>
                            <input type="text" name="ApproveMessage" class="input-field" placeholder="Optional message..." />
                            <button type="submit" class="btn btn-approve">
                                <i class="fas fa-check"></i> Approve & Publish
                            </button>
                        </form>

                        <!-- Reject -->
                        <form method="post" asp-page-handler="Reject" class="decision-card reject-card">
                            <input type="hidden" name="ClassSectionId" value="@gradebook.ClassSectionId" />
                            <h3><i class="fas fa-times-circle"></i> Reject</h3>
                            <input type="text" name="RejectReason" class="input-field" placeholder="Reason is required..." required />
                            <button type="submit" class="btn btn-reject">
                                <i class="fas fa-times"></i> Reject
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-folder-open"></i>
                <p>Gradebook not found.</p>
            </div>
        }
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/GradebookManagement/Review.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (() => {
            const analytics = @Html.Raw(JsonSerializer.Serialize(Model.GradeAnalytics));
            if (!analytics) {
                return;
            }

            const chartsSection = document.getElementById('gradeChartsSection');
            const toggleBtn = document.getElementById('toggleChartsBtn');
            const toggleText = document.getElementById('toggleChartsText');

            if (!chartsSection || !toggleBtn || !toggleText) {
                return;
            }

            let isVisible = false;
            let chartsInitialized = false;

            toggleBtn.addEventListener('click', () => {
                isVisible = !isVisible;
                chartsSection.classList.toggle('is-hidden', !isVisible);
                toggleBtn.setAttribute('aria-expanded', isVisible ? 'true' : 'false');
                toggleText.textContent = isVisible
                    ? 'Ẩn thống kê biểu đồ'
                    : 'Hiển thị thống kê biểu đồ';

                if (isVisible && !chartsInitialized) {
                    initCharts();
                    chartsInitialized = true;
                }
            });

            function initCharts() {
                new Chart(document.getElementById('scoreDistributionChart'), {
                    type: 'bar',
                    data: {
                        labels: analytics.DistributionLabels,
                        datasets: [{
                            label: 'Số lượng sinh viên',
                            data: analytics.DistributionValues,
                            backgroundColor: '#14B8A6',
                            borderColor: '#0F766E',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    precision: 0
                                }
                            }
                        }
                    }
                });

                new Chart(document.getElementById('gradeItemsPerformanceChart'), {
                    type: 'radar',
                    data: {
                        labels: analytics.PerformanceLabels,
                        datasets: [{
                            label: 'Điểm trung bình (thang 10)',
                            data: analytics.PerformanceValues,
                            fill: true,
                            backgroundColor: 'rgba(59, 130, 246, 0.2)',
                            borderColor: '#2563EB',
                            pointBackgroundColor: '#2563EB'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            r: {
                                min: 0,
                                max: 10,
                                ticks: {
                                    stepSize: 2
                                }
                            }
                        }
                    }
                });

                new Chart(document.getElementById('rankingRatioChart'), {
                    type: 'doughnut',
                    data: {
                        labels: analytics.RankingLabels,
                        datasets: [{
                            data: analytics.RankingValues,
                            backgroundColor: [
                                '#EF4444',
                                '#F59E0B',
                                '#10B981',
                                '#3B82F6',
                                '#8B5CF6'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }
        })();
    </script>
}
