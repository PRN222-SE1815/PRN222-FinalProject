@page
@model Presentation.Areas.Admin.Pages.Reports.IndexModel
@using Microsoft.AspNetCore.Html
@using System.Text.Json
@{
    ViewData["Title"] = "Reports & Analytics";
    var dashboard = Model.Dashboard;
}

<section class="reports-page">
    <div class="reports-container">
        <div class="page-header">
            <div>
                <h1 class="page-title"><i class="fas fa-chart-line"></i> Reports & Analytics</h1>
                <p class="page-subtitle">Track enrollment, revenue, learning outcomes, and grade appeal quality.</p>
            </div>
            <a asp-area="Admin" asp-page="/Index" class="btn btn-back"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i> @Model.ErrorMessage
            </div>
        }

        @if (dashboard is not null)
        {
            <form method="get" class="filter-card">
                <div class="filter-grid">
                    <div class="field-group checkbox-group">
                        <input type="checkbox" id="includeAllSemesters" name="IncludeAllSemesters" value="true" @(dashboard.IncludeAllSemesters ? "checked" : null) />
                        <label for="includeAllSemesters">All semesters</label>
                    </div>

                    <div class="field-group">
                        <label for="semesterId">Selected semester</label>
                        <select id="semesterId" name="SemesterId" @((dashboard.IncludeAllSemesters) ? "disabled" : null)>
                            @foreach (var semester in dashboard.SemesterOptions)
                            {
                                <option value="@semester.SemesterId" selected="@(dashboard.SelectedSemesterId == semester.SemesterId)">
                                    @semester.SemesterCode - @semester.SemesterName @(semester.IsActive ? "★" : string.Empty)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="field-group">
                        <label for="compareSemesterId">Compare semester</label>
                        <select id="compareSemesterId" name="CompareSemesterId" @((dashboard.IncludeAllSemesters) ? "disabled" : null)>
                            <option value="">Auto previous</option>
                            @foreach (var semester in dashboard.SemesterOptions)
                            {
                                if (dashboard.SelectedSemesterId == semester.SemesterId)
                                {
                                    continue;
                                }

                                <option value="@semester.SemesterId" selected="@(dashboard.CompareSemesterId == semester.SemesterId)">
                                    @semester.SemesterCode - @semester.SemesterName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="field-group actions">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-filter"></i> Apply</button>
                    </div>
                </div>
            </form>

            <div class="scope-note">
                <span><strong>Scope:</strong> @dashboard.SelectedSemesterLabel</span>
                @if (!string.IsNullOrWhiteSpace(dashboard.CompareSemesterLabel))
                {
                    <span><strong>Compared with:</strong> @dashboard.CompareSemesterLabel</span>
                }
            </div>

            <div class="kpi-grid">
                <article class="kpi-card">
                    <h3>Total Enrollments</h3>
                    <p class="kpi-value">@dashboard.TotalEnrollments.CurrentValue.ToString("N0")</p>
                    @RenderDelta(dashboard.TotalEnrollments.ChangePercent)
                </article>

                <article class="kpi-card">
                    <h3>Total Revenue</h3>
                    <p class="kpi-value">@dashboard.TotalRevenue.CurrentValue.ToString("N0") VND</p>
                    @RenderDelta(dashboard.TotalRevenue.ChangePercent)
                </article>

                <article class="kpi-card">
                    <h3>Average Pass Rate</h3>
                    <p class="kpi-value">@dashboard.AveragePassRate.CurrentValue.ToString("0.##")%</p>
                    @RenderDelta(dashboard.AveragePassRate.ChangePercent)
                </article>

                <article class="kpi-card">
                    <h3>Active Students</h3>
                    <p class="kpi-value">@dashboard.ActiveStudents.CurrentValue.ToString("N0")</p>
                    @RenderDelta(dashboard.ActiveStudents.ChangePercent)
                </article>
            </div>

            <div class="chart-grid">
                <div class="chart-card">
                    <h3>Revenue trend by month (Deposit)</h3>
                    <div class="chart-canvas-wrap">
                        <canvas id="revenueTrendChart"></canvas>
                    </div>
                </div>

                <div class="chart-card">
                    <h3>Top 5 fastest-growing programs</h3>
                    <div class="chart-canvas-wrap">
                        <canvas id="programGrowthChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="table-grid">
                <div class="table-card">
                    <h3>Top 5 courses with highest fail rate</h3>
                    <div class="table-wrapper">
                        <table class="analytics-table">
                            <thead>
                                <tr>
                                    <th>Course</th>
                                    <th class="text-right">Total</th>
                                    <th class="text-right">Failed</th>
                                    <th class="text-right">Fail Rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (dashboard.HighestFailRateCourses.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="empty-cell">No fail-rate data available.</td>
                                    </tr>
                                }

@functions {
    IHtmlContent RenderDelta(decimal? value)
    {
        if (!value.HasValue)
        {
            return new HtmlString("<span class=\"kpi-delta delta-neutral\">N/A <small>(no comparison)</small></span>");
        }

        var symbol = value.Value > 0 ? "+" : string.Empty;
        var cssClass = value.Value > 0 ? "delta-positive" : value.Value < 0 ? "delta-negative" : "delta-neutral";
        return new HtmlString($"<span class=\"kpi-delta {cssClass}\" data-kpi-delta=\"{value.Value}\">{symbol}{value.Value:0.##}% <small>vs previous semester</small></span>");
    }
}
                                else
                                {
                                    @foreach (var row in dashboard.HighestFailRateCourses)
                                    {
                                        <tr>
                                            <td>
                                                <div class="primary">@row.CourseCode</div>
                                                <div class="secondary">@row.CourseName</div>
                                            </td>
                                            <td class="text-right">@row.TotalStudents</td>
                                            <td class="text-right">@row.FailedStudents</td>
                                            <td class="text-right">@row.FailRatePercent.ToString("0.##")%</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="table-card">
                    <h3>Grade appeals by course (Approved vs Rejected)</h3>
                    <div class="table-wrapper">
                        <table class="analytics-table">
                            <thead>
                                <tr>
                                    <th>Course</th>
                                    <th class="text-right">Approved</th>
                                    <th class="text-right">Rejected</th>
                                    <th class="text-right">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (dashboard.GradeAppealSummaries.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="empty-cell">No appeal data available.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var row in dashboard.GradeAppealSummaries)
                                    {
                                        <tr>
                                            <td>
                                                <div class="primary">@row.CourseCode</div>
                                                <div class="secondary">@row.CourseName</div>
                                            </td>
                                            <td class="text-right">@row.ApprovedCount</td>
                                            <td class="text-right">@row.RejectedCount</td>
                                            <td class="text-right">@(row.ApprovedCount + row.RejectedCount)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/Reports/Index.css" asp-append-version="true" />
}

@section Scripts {
    @if (dashboard is not null)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            (() => {
                const data = @Html.Raw(JsonSerializer.Serialize(dashboard));
                if (!data) {
                    return;
                }

                const deltaElements = document.querySelectorAll('[data-kpi-delta]');
                deltaElements.forEach((el) => {
                    const value = Number(el.dataset.kpiDelta);
                    if (!Number.isFinite(value)) {
                        return;
                    }

                    if (value > 0) {
                        el.classList.add('delta-positive');
                    } else if (value < 0) {
                        el.classList.add('delta-negative');
                    } else {
                        el.classList.add('delta-neutral');
                    }
                });

                const revenueDatasets = [{
                    label: data.SelectedSemesterLabel,
                    data: data.RevenueChart.CurrentValues,
                    borderColor: '#2563EB',
                    backgroundColor: 'rgba(37, 99, 235, 0.12)',
                    fill: true,
                    tension: 0.25
                }];

                if (data.RevenueChart.CompareValues && data.RevenueChart.CompareValues.length > 0) {
                    revenueDatasets.push({
                        label: data.CompareSemesterLabel ?? 'Comparison',
                        data: data.RevenueChart.CompareValues,
                        borderColor: '#94A3B8',
                        backgroundColor: 'rgba(148, 163, 184, 0.08)',
                        fill: true,
                        tension: 0.25
                    });
                }

                new Chart(document.getElementById('revenueTrendChart'), {
                    type: 'line',
                    data: {
                        labels: data.RevenueChart.Labels,
                        datasets: revenueDatasets
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });

                new Chart(document.getElementById('programGrowthChart'), {
                    type: 'bar',
                    data: {
                        labels: data.ProgramGrowthChart.Labels,
                        datasets: [{
                            label: '% enrollment growth',
                            data: data.ProgramGrowthChart.GrowthPercentValues,
                            backgroundColor: '#14B8A6',
                            borderColor: '#0F766E',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: {
                                ticks: {
                                    callback: function (value) { return `${value}%`; }
                                }
                            }
                        }
                    }
                });
            })();
        </script>
    }
}
