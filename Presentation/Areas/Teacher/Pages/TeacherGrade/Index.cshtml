@page
@model Presentation.Areas.Teacher.Pages.TeacherGrade.IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "Gradebook";
    var gradebook = Model.Gradebook;
    var canEdit = Model.CanEdit;
}

<section class="gradebook-page">
    <div class="gradebook-container">
        <div class="page-header">
            <div class="header-content">
                <h1 class="page-title"><i class="fas fa-pen-to-square"></i> Gradebook</h1>
                <p class="page-subtitle">Enter and manage grades for your class section.</p>
            </div>
            <a asp-area="Teacher" asp-page="/MyClasses/Index" class="btn btn-back">
                <i class="fas fa-arrow-left"></i> Back to My Classes
            </a>
        </div>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> @Model.SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i> @Model.ErrorMessage
            </div>
        }

        @if (gradebook is not null)
        {
            <!-- Status Badge -->
            <div class="gradebook-info">
                <span class="info-label">Class:</span>
                <span class="info-value">@gradebook.SectionCode</span>
                <span class="info-label">Course:</span>
                <span class="info-value">@gradebook.CourseCode — @gradebook.CourseName</span>
                <span class="info-label">Semester:</span>
                <span class="info-value">@gradebook.SemesterName</span>
                <span class="info-label">Status:</span>
                <span class="status-badge status-@gradebook.Status.ToLower().Replace("_", "-")">@gradebook.Status</span>
                <span class="info-label">Version:</span>
                <span class="info-value">@gradebook.Version</span>
            </div>

            @if (Model.AppealId.HasValue && Model.HighlightEnrollmentId.HasValue)
            {
                <div class="appeal-focus-bar">
                    <div class="appeal-focus-title">
                        <i class="fas fa-scale-balanced"></i>
                        Đang xem ngữ cảnh khiếu nại cho Enrollment #@Model.HighlightEnrollmentId
                    </div>
                    <form method="get" asp-area="Teacher" asp-page="/GradeAppeals/Review" asp-route-id="@Model.AppealId" class="appeal-score-form">
                        @if (Model.AppealFocusGradeItems.Count > 0)
                        {
                            <div class="table-wrapper" style="margin-bottom:0.5rem;">
                                <table class="grade-table">
                                    <thead>
                                        <tr>
                                            <th>Grade item khiếu nại</th>
                                            <th>Điểm mới</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < Model.AppealFocusGradeItems.Count; i++)
                                        {
                                            var item = Model.AppealFocusGradeItems[i];
                                            <tr>
                                                <td>
                                                    <input type="hidden" name="PrefillScoreUpdates[@i].GradeItemId" value="@item.GradeItemId" />
                                                    <strong>@item.ItemName</strong>
                                                    <div class="item-meta">Hiện tại: @(item.CurrentScore?.ToString("0.##") ?? "—") / @item.MaxScore.ToString("0.##")</div>
                                                </td>
                                                <td>
                                                    <input type="number"
                                                           name="PrefillScoreUpdates[@i].NewScore"
                                                           value="@(item.PrefillNewScore?.ToString("0.##"))"
                                                           class="quick-score-input"
                                                           step="0.01" min="0" max="@item.MaxScore.ToString("0.##")"
                                                           placeholder="Nhập điểm" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-share"></i> Áp dụng vào xử lý khiếu nại
                        </button>
                    </form>
                </div>
            }

            @if (Model.GradeAnalytics is not null)
            {
                <div class="chart-toggle-bar">
                    <button type="button" id="toggleChartsBtn" class="btn btn-secondary" aria-expanded="false" aria-controls="gradeChartsSection">
                        <i class="fas fa-chart-simple"></i>
                        <span id="toggleChartsText">Hiển thị thống kê biểu đồ</span>
                    </button>
                </div>

                <section id="gradeChartsSection" class="grade-charts is-hidden">
                    <div class="chart-row">
                        <div class="chart-card">
                            <h3 class="chart-title">Phân bố điểm tổng kết</h3>
                            <div class="chart-canvas-wrap">
                                <canvas id="scoreDistributionChart"></canvas>
                            </div>
                        </div>
                        <div class="chart-card">
                            <h3 class="chart-title">Điểm trung bình theo từng bài kiểm tra</h3>
                            <div class="chart-canvas-wrap">
                                <canvas id="gradeItemsPerformanceChart"></canvas>
                            </div>
                        </div>
                        <div class="chart-card">
                            <h3 class="chart-title">Tỉ lệ xếp loại học lực</h3>
                            <div class="chart-canvas-wrap">
                                <canvas id="rankingRatioChart"></canvas>
                            </div>
                        </div>
                    </div>

                    <div class="ranking-row">
                        <div class="chart-card ranking-card">
                            <h3 class="chart-title">Top 3 sinh viên điểm trung bình cao nhất</h3>
                            <div class="mini-table-wrap">
                                <table class="mini-ranking-table">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Student</th>
                                            <th>Điểm TB</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < Model.GradeAnalytics.TopStudents.Count; i++)
                                        {
                                            var student = Model.GradeAnalytics.TopStudents[i];
                                            <tr>
                                                <td>@(i + 1)</td>
                                                <td>
                                                    <div class="mini-student-name">@student.StudentName</div>
                                                    <div class="mini-student-code">@student.StudentCode</div>
                                                </td>
                                                <td>@student.AverageScore.ToString("0.##")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="chart-card ranking-card">
                            <h3 class="chart-title">Top 3 sinh viên điểm trung bình thấp nhất</h3>
                            <div class="mini-table-wrap">
                                <table class="mini-ranking-table">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Student</th>
                                            <th>Điểm TB</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < Model.GradeAnalytics.BottomStudents.Count; i++)
                                        {
                                            var student = Model.GradeAnalytics.BottomStudents[i];
                                            <tr>
                                                <td>@(i + 1)</td>
                                                <td>
                                                    <div class="mini-student-name">@student.StudentName</div>
                                                    <div class="mini-student-code">@student.StudentCode</div>
                                                </td>
                                                <td>@student.AverageScore.ToString("0.##")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>
            }

            @if (gradebook.GradeItems.Count == 0)
            {
                <div class="empty-state">
                    <i class="fas fa-clipboard"></i>
                    <p>No grade items configured for this gradebook. Admin must create grade items first.</p>
                </div>
            }
            else if (Model.EnrollmentRows.Count == 0)
            {
                <div class="empty-state">
                    <i class="fas fa-user-slash"></i>
                    <p>No enrollments found for grading.</p>
                </div>
            }
            else
            {
                <!-- Grade Table -->
                <form method="post" asp-page-handler="Save">
                    <input type="hidden" name="SaveRequest.ClassSectionId" value="@gradebook.ClassSectionId" />

                    <div class="table-wrapper">
                        <table class="grade-table">
                            <thead>
                                <tr>
                                    <th class="sticky-col">Student</th>
                                    @foreach (var item in gradebook.GradeItems)
                                    {
                                        <th>
                                            <div class="item-header">
                                                <span class="item-name">@item.ItemName</span>
                                                <span class="item-meta">Max: @item.MaxScore</span>
                                                @if (item.Weight.HasValue)
                                                {
                                                    <span class="item-meta">W: @(item.Weight.Value * 100)%</span>
                                                }
                                            </div>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @{ var scoreIdx = 0; }
                                @foreach (var row in Model.EnrollmentRows)
                                {
                                    <tr id="enrollment-@row.EnrollmentId" class="@(Model.HighlightEnrollmentId == row.EnrollmentId ? "row-focus" : "")">
                                        <td class="sticky-col">
                                            <div class="student-info">
                                                <span class="student-name">@row.StudentName</span>
                                                <span class="student-code">@row.StudentCode</span>
                                            </div>
                                        </td>
                                        @foreach (var item in gradebook.GradeItems)
                                        {
                                            row.Scores.TryGetValue(item.GradeItemId, out var cellScore);
                                            <td class="score-cell @(Model.HighlightEnrollmentId == row.EnrollmentId && (Model.HighlightGradeItemId == item.GradeItemId || Model.AppealFocusGradeItemIds.Contains(item.GradeItemId)) ? "score-cell-focus" : "")">
                                                <input type="hidden" name="SaveRequest.Scores[@scoreIdx].GradeItemId" value="@item.GradeItemId" />
                                                <input type="hidden" name="SaveRequest.Scores[@scoreIdx].EnrollmentId" value="@row.EnrollmentId" />
                                                <input type="number"
                                                       name="SaveRequest.Scores[@scoreIdx].Score"
                                                       value="@(cellScore?.ToString("0.##"))"
                                                       step="0.01" min="0" max="10"
                                                       class="score-input"
                                                       @(canEdit ? "" : "disabled") />
                                            </td>
                                            scoreIdx++; 
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="action-bar">
                        <button type="submit" class="btn btn-primary" @(canEdit ? "" : "disabled")>
                            <i class="fas fa-save"></i> Save Scores
                        </button>
                    </div>
                </form>

                <div class="action-bar" style="margin-top:0.75rem;">
                    <form method="post" asp-page-handler="Export" style="display:inline-flex;">
                        <input type="hidden" name="classSectionId" value="@gradebook.ClassSectionId" />
                        <input type="hidden" name="format" value="csv" />
                        <button type="submit" class="btn btn-secondary">
                            <i class="fas fa-file-csv"></i> Export CSV
                        </button>
                    </form>
                    <form method="post" asp-page-handler="Export" style="display:inline-flex; margin-left:0.5rem;">
                        <input type="hidden" name="classSectionId" value="@gradebook.ClassSectionId" />
                        <input type="hidden" name="format" value="xlsx" />
                        <button type="submit" class="btn btn-secondary">
                            <i class="fas fa-file-excel"></i> Export XLSX
                        </button>
                    </form>
                </div>

                <!-- Submit for Review -->
                <form method="post" asp-page-handler="SubmitReview" class="review-form">
                    <input type="hidden" name="ApprovalRequest.ClassSectionId" value="@gradebook.ClassSectionId" />
                    <div class="review-section">
                        <label for="approvalMessage">Message (optional):</label>
                        <input type="text" id="approvalMessage" name="ApprovalRequest.RequestMessage" class="input-field" placeholder="Optional message to admin..." />
                        <button type="submit" class="btn btn-accent" @(canEdit ? "" : "disabled")>
                            <i class="fas fa-paper-plane"></i> Submit for Review
                        </button>
                    </div>
                </form>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-folder-open"></i>
                <p>No gradebook found for this class section.</p>
                <a asp-area="Teacher" asp-page="/MyClasses/Index" class="btn btn-primary" style="margin-top:1rem;display:inline-flex;">
                    <i class="fas fa-arrow-left"></i> Back to My Classes
                </a>
            </div>
        }
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/Teacher/TeacherGrade/Index.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (() => {
            const analytics = @Html.Raw(JsonSerializer.Serialize(Model.GradeAnalytics));
            if (!analytics) {
                return;
            }

            const chartsSection = document.getElementById('gradeChartsSection');
            const toggleBtn = document.getElementById('toggleChartsBtn');
            const toggleText = document.getElementById('toggleChartsText');

            if (!chartsSection || !toggleBtn || !toggleText) {
                return;
            }

            let isVisible = false;
            let chartsInitialized = false;

            toggleBtn.addEventListener('click', () => {
                isVisible = !isVisible;
                chartsSection.classList.toggle('is-hidden', !isVisible);
                toggleBtn.setAttribute('aria-expanded', isVisible ? 'true' : 'false');
                toggleText.textContent = isVisible
                    ? 'Ẩn thống kê biểu đồ'
                    : 'Hiển thị thống kê biểu đồ';

                if (isVisible && !chartsInitialized) {
                    initCharts();
                    chartsInitialized = true;
                }
            });

            function initCharts() {
                new Chart(document.getElementById('scoreDistributionChart'), {
                    type: 'bar',
                    data: {
                        labels: analytics.DistributionLabels,
                        datasets: [{
                            label: 'Số lượng sinh viên',
                            data: analytics.DistributionValues,
                            backgroundColor: '#14B8A6',
                            borderColor: '#0F766E',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    precision: 0
                                }
                            }
                        }
                    }
                });

                new Chart(document.getElementById('gradeItemsPerformanceChart'), {
                    type: 'radar',
                    data: {
                        labels: analytics.PerformanceLabels,
                        datasets: [{
                            label: 'Điểm trung bình (thang 10)',
                            data: analytics.PerformanceValues,
                            fill: true,
                            backgroundColor: 'rgba(59, 130, 246, 0.2)',
                            borderColor: '#2563EB',
                            pointBackgroundColor: '#2563EB'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            r: {
                                min: 0,
                                max: 10,
                                ticks: {
                                    stepSize: 2
                                }
                            }
                        }
                    }
                });

                new Chart(document.getElementById('rankingRatioChart'), {
                    type: 'doughnut',
                    data: {
                        labels: analytics.RankingLabels,
                        datasets: [{
                            data: analytics.RankingValues,
                            backgroundColor: [
                                '#EF4444',
                                '#F59E0B',
                                '#10B981',
                                '#3B82F6',
                                '#8B5CF6'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }
        })();
    </script>
}
