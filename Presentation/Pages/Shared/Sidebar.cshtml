@using System.Security.Claims
@{
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var isAdmin = userRole == "ADMIN";
    var isTeacher = userRole == "TEACHER";
    var isStudent = userRole == "STUDENT";
}

<aside class="sidebar">
    <div class="sidebar-brand">
        @if (isAdmin)
        {
            <a asp-area="Admin" asp-page="/Index" class="brand-link">
                <span class="brand-icon"><i class="fas fa-graduation-cap"></i></span>
                <span class="brand-text">TPF University</span>
            </a>
        }
        else if (isTeacher)
        {
            <a asp-area="Teacher" asp-page="/Index" class="brand-link">
                <span class="brand-icon"><i class="fas fa-graduation-cap"></i></span>
                <span class="brand-text">TPF University</span>
            </a>
        }
        else if (isStudent)
        {
            <a asp-area="Student" asp-page="/Index" class="brand-link">
                <span class="brand-icon"><i class="fas fa-graduation-cap"></i></span>
                <span class="brand-text">TPF University</span>
            </a>
        }
        else
        {
            <a asp-page="/Account/Login" class="brand-link">
                <span class="brand-icon"><i class="fas fa-graduation-cap"></i></span>
                <span class="brand-text">TPF University</span>
            </a>
        }

        <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar" title="Toggle sidebar">
            <i class="fas fa-bars"></i>
        </button>
    </div>

    <div class="sidebar-menu">
        @if (isAdmin)
        {
            <a asp-area="Admin" asp-page="/UserManagement/Create" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-users-cog"></i></span>
                <span class="sidebar-text">User Management</span>
            </a>
            <a asp-area="Admin" asp-page="/ScheduleManagement/Index" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-calendar-alt"></i></span>
                <span class="sidebar-text">Schedule</span>
            </a>
            <a asp-area="Admin" asp-page="/GradebookManagement/Index" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-clipboard-check"></i></span>
                <span class="sidebar-text">Gradebook</span>
            </a>
            <a asp-area="Admin" asp-page="/GradeAppeals/Index" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-scale-balanced"></i></span>
                <span class="sidebar-text">Appeals</span>
            </a>
            <a asp-page="/Chat/Index" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-comments"></i></span>
                <span class="sidebar-text">Chat</span>
            </a>
            <a asp-area="Admin" asp-page="/CourseManagement/Index" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-book"></i></span>
                <span class="sidebar-text">Courses</span>
            </a>
            <a href="#" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-chart-bar"></i></span>
                <span class="sidebar-text">Reports</span>
            </a>
        }
        else if (isTeacher)
        {
            <a asp-area="Teacher" asp-page="/TeacherSchedule/Index" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-calendar-alt"></i></span>
                <span class="sidebar-text">Schedule</span>
            </a>
            <a asp-area="Teacher" asp-page="/MyClasses/Index" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-chalkboard-teacher"></i></span>
                <span class="sidebar-text">My Classes</span>
            </a>
            <a asp-area="Teacher" asp-page="/GradeAppeals/Queue" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-scale-balanced"></i></span>
                <span class="sidebar-text">Appeals</span>
            </a>
            <a asp-page="/Chat/Index" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-comments"></i></span>
                <span class="sidebar-text">Chat</span>
            </a>
        }
        else if (isStudent)
        {
            <a asp-area="Student" asp-page="/MyCourses/Index" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-book-open"></i></span>
                <span class="sidebar-text">My Courses</span>
            </a>
            <a asp-area="Student" asp-page="/CourseRegistration/Index" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-plus-circle"></i></span>
                <span class="sidebar-text">Registration</span>
            </a>
            <a asp-area="Student" asp-page="/StudentSchedule/Index" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-calendar-alt"></i></span>
                <span class="sidebar-text">Schedule</span>
            </a>
            <a asp-area="Student" asp-page="/StudentGrade/Index" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-graduation-cap"></i></span>
                <span class="sidebar-text">Grades</span>
            </a>
            <a asp-area="Student" asp-page="/GradeAppeals/Index" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-scale-balanced"></i></span>
                <span class="sidebar-text">Appeals</span>
            </a>
            <a asp-page="/Chat/Index" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-comments"></i></span>
                <span class="sidebar-text">Chat</span>
            </a>
            <a asp-area="Student" asp-page="/AI/Index" class="sidebar-link">
                <span class="sidebar-icon"><i class="fas fa-robot"></i></span>
                <span class="sidebar-text">AI Assistant</span>
            </a>
        }
    </div>
</aside>
